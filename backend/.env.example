APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me

# CORS — comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:80

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_email_assistant
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_MAX_RETRIES=3
CELERY_RETRY_BACKOFF_MAX=600

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Frontend / session
FRONTEND_BASE_URL=http://localhost:5173
SESSION_TTL_SECONDS=604800

# Token encryption
TOKEN_ENCRYPTION_KEY=change-me

# LLM Provider
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
LLM_CLASSIFICATION_MODEL=openai/gpt-oss-20b
LLM_DRAFTING_MODEL=openai/gpt-oss-20b
LLM_CRITIQUE_MODEL=openai/gpt-oss-20b

# Embeddings — uses local sentence-transformers model (all-MiniLM-L6-v2)
# No API key required. The model downloads automatically on first use.

RATE_LIMIT_PER_MINUTE=60
